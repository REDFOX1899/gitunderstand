# ── GitUnderstand Backend (.env) ──

# Server
HOST=0.0.0.0
PORT=8080
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# Storage: local filesystem or Google Cloud Storage
USE_LOCAL_STORAGE=true
LOCAL_STORAGE_PATH=/tmp/gitunderstand

# GitHub token (optional): increases rate limit from 60/hr to 5,000/hr
# Get one at https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_TOKEN=ghp_...

# AI features: BYOK — users provide their own Gemini API key via the UI
# No server-side AI key is needed

# GitHub PAT for diagram backend (same token works)
# GITHUB_PAT=ghp_...

# ── GCP (only needed for Cloud Run deployment) ──
# GCP_PROJECT_ID=gitunderstand
# GCS_BUCKET_NAME=gitunderstand-digests
