# ── GitDiagram Backend (.env) ──

# Optional: Default Gemini API key (users provide their own keys via the UI)
# Get one at https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza...

# Optional: GitHub PAT increases rate limits from 60/hr to 5,000/hr
# Get one at https://github.com/settings/tokens (no scopes needed for public repos)
# GITHUB_PAT=ghp_...

# Runtime environment: "development" (hot reload) or "production" (multi-worker)
ENVIRONMENT=development

# CORS: comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
